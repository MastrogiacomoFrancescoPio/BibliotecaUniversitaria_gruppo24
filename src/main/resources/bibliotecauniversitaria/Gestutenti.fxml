<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="pane" fx:controller="bibliotecauniversitaria.controllers.GestioneUtentiController"
            maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0" 
            prefHeight="789.0" prefWidth="997.0" 
            xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1">

   <top>
      <VBox style="-fx-background-color: #f58d3e;" BorderPane.alignment="CENTER">
         <children>
            
            <StackPane prefHeight="100.0">
               <padding>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="GESTIONE UTENTI">
                     <font>
                        <Font name="System Bold" size="48.0" />
                     </font>
                  </Text>
                  
                  <AnchorPane pickOnBounds="false">
                     <children>
                        <Button onAction="#onMenu" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="10.0"
                                mnemonicParsing="false" prefHeight="40.0" style="-fx-background-radius: 20; -fx-background-color: orange; -fx-font-family: Arial; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(168, 25, 25, 0.4), 8, 0, 0, 0); -fx-border-radius: 5px;" styleClass="button-base" stylesheets="@css/bottone.css" text="TORNA AL MENU" textFill="WHITE">
                           <font>
                              <Font name="System Italic" size="18.0" />
                           </font>
                        </Button>
                        
                        <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <image>
                              <Image url="@immagini/logo_standard.png" />
                           </image>
                        </ImageView>
                     </children>
                  </AnchorPane>
               </children>
            </StackPane>

            <HBox alignment="CENTER" spacing="20.0">
               <padding>
                  <Insets bottom="10.0" top="0.0" />
               </padding>
               <children>
                  <Button onAction="#onRicerca" prefHeight="50.0" prefWidth="120.0" style="-fx-background-radius: 20; -fx-background-color: orange; -fx-font-family: Arial; -fx-font-size: 17px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(168, 25, 25, 0.4), 8, 0, 0, 0); -fx-border-radius: 5px;" styleClass="button-base" stylesheets="@css/bottone.css" text="RICERCA" textFill="WHITE">
                     <font>
                        <Font name="System Italic" size="20.0" />
                     </font>
                  </Button>
                  <Button onAction="#onAggiungi" prefHeight="50.0" prefWidth="120.0" style="-fx-background-radius: 20; -fx-background-color: orange; -fx-font-family: Arial; -fx-font-size: 17px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(168, 25, 25, 0.4), 8, 0, 0, 0); -fx-border-radius: 5px;" styleClass="button-base" stylesheets="@css/bottone.css" text="AGGIUNGI" textFill="WHITE">
                     <font>
                        <Font name="System Italic" size="20.0" />
                     </font>
                  </Button>
                  <Button onAction="#onRimuovi" prefHeight="50.0" prefWidth="120.0" style="-fx-background-radius: 20; -fx-background-color: orange; -fx-font-family: Arial; -fx-font-size: 17px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(168, 25, 25, 0.4), 8, 0, 0, 0); -fx-border-radius: 5px;" styleClass="button-base" stylesheets="@css/bottone.css" text="RIMUOVI" textFill="WHITE">
                     <font>
                        <Font name="System Italic" size="20.0" />
                     </font>
                  </Button>
                  <Button fx:id="sospendiBtn" onAction="#onSospendi" prefHeight="50.0" prefWidth="120.0" style="-fx-background-radius: 20; -fx-background-color: orange; -fx-font-family: Arial; -fx-font-size: 17px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(168, 25, 25, 0.4), 8, 0, 0, 0); -fx-border-radius: 5px;" styleClass="button-base" stylesheets="@css/bottone.css" text="SOSPENDI" textFill="WHITE">
                     <font>
                        <Font name="System Italic" size="20.0" />
                     </font>
                  </Button>
               </children>
            </HBox>

            <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 0 0 15 0;">
               <children>
                  <MenuButton mnemonicParsing="false" text="Filtra per">
                     <items>
                        <MenuItem onAction="#onOrdinaMatricola" mnemonicParsing="false" text="Matricola" />
                        <MenuItem onAction="#onOrdinaNome" mnemonicParsing="false" text="Nome" />
                        <MenuItem onAction="#onOrdinaCognome" mnemonicParsing="false" text="Cognome" />
                     </items>
                  </MenuButton>
                  
                  <Label text="Nome:" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                     <padding><Insets left="10.0" /></padding>
                  </Label>
                  <TextField fx:id="nomeTxt" prefWidth="130.0" promptText="Nome" />
                  
                  <Label text="Cognome:" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Label>
                  <TextField fx:id="cognomeTxt" prefWidth="130.0" promptText="Cognome" />
                  
                  <Label text="Matricola:" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Label>
                  <TextField fx:id="matricolaTxt" prefWidth="100.0" promptText="Matricola" />
                  
                  <Label text="E-mail:" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Label>
                  <TextField fx:id="emailTxt" prefWidth="150.0" promptText="E-mail" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <TableView fx:id="tabellaUtenti" style="-fx-background-color: #ffb777;" stylesheets="@css/tabella.css" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colonnaNome" text="Nome" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colonnaCognome" text="Cognome" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colonnaMatricola" text="Matricola" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colonnaEmail" text="E-mail" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colonnaPrestiti" text="Prestiti attivi" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colonnaSegnalazioni" text="Segnalazioni" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colonnaSospensioni" text="Sospensione" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colonnaFineSospensioni" text="Fine sospensione" style="-fx-alignment: CENTER;" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <styleClass>
            <String fx:value="column-header" />
            <String fx:value="label" />
            <String fx:value="table-cell" />
            <String fx:value="table-row-cell" />
            <String fx:value="table-view" />
         </styleClass>
      </TableView>
   </center>
</BorderPane>