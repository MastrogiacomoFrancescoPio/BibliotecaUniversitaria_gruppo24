<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" prefHeight="789.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bibliotecauniversitaria.controllers.MenuController">
   <children>
      <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}" preserveRatio="false">
         <image>
            <Image url="@immagini/sfondo.jpg" />
         </image>
      </ImageView>

      <BorderPane>
         <top>
            <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="10.0" style="-fx-background-color: #ffb41f;" BorderPane.alignment="CENTER">
               <children>
                  <ImageView fitHeight="62.0" fitWidth="67.0" preserveRatio="true">
                     <image>
                        <Image url="@immagini/logo_standard.png" />
                     </image>
                     <HBox.margin>
                        <Insets left="5.0" />
                     </HBox.margin>
                  </ImageView>
                  <Text fill="#f8f5f5" strokeType="OUTSIDE" strokeWidth="0.0" text="Università degli studi di Salerno">
                     <font>
                        <Font name="System Bold" size="30.0" />
                     </font>
                  </Text>
               </children>
            </HBox>
         </top>

         <center>
            <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="420.0" style="-fx-background-color: #f8eededb; -fx-background-radius: 30; -fx-border-color: black; -fx-border-radius: 30; -fx-border-width: 1px;">
                     <children>
                        <VBox alignment="CENTER" spacing="0.0" style="-fx-background-color: #ffac1f; -fx-background-radius: 29 29 0 0; -fx-border-color: black; -fx-border-width: 0 0 1 0; -fx-border-radius: 29 29 0 0;">
                           <padding>
                              <Insets bottom="5.0" top="2.0" />
                           </padding>
                           <children>
                              <StackPane>
                                 <children>
                                    <Circle fill="#f2f3f5" radius="25.0" stroke="TRANSPARENT" strokeType="INSIDE" />
                                    <ImageView fitHeight="90.0" fitWidth="95.0" preserveRatio="true">
                                       <image>
                                          <Image url="@immagini/logo2.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </StackPane>
                              <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="MENU PRINCIPALE" textAlignment="CENTER">
                                 <font>
                                    <Font name="System Bold Italic" size="24.0" />
                                 </font>
                                 <VBox.margin>
                                    <Insets top="0.0" />
                                 </VBox.margin>
                              </Text>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="25.0">
                           <padding>
                              <Insets bottom="40.0" left="30.0" right="30.0" top="40.0" />
                           </padding>
                           <children>
                              <Button onAction="#onGestioneLibri" prefHeight="70.0" prefWidth="280.0" style="-fx-background-radius: 20; -fx-background-color: orange; -fx-font-family: Arial; -fx-font-size: 21px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(168, 25, 25, 0.4), 8, 0, 0, 0); -fx-border-radius: 5px;" text="GESTIONE LIBRI" textFill="WHITE" />
                              <Button onAction="#onGestionePrestiti" prefHeight="70.0" prefWidth="280.0" style="-fx-background-radius: 20; -fx-background-color: orange; -fx-font-family: Arial; -fx-font-size: 21px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(168, 25, 25, 0.4), 8, 0, 0, 0); -fx-border-radius: 5px;" text="GESTIONE PRESTITI" textFill="WHITE" />
                              <Button onAction="#onGestioneUtenti" prefHeight="70.0" prefWidth="280.0" style="-fx-background-radius: 20; -fx-background-color: orange; -fx-font-family: Arial; -fx-font-size: 21px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(168, 25, 25, 0.4), 8, 0, 0, 0); -fx-border-radius: 5px;" text="GESTIONE UTENTI" textFill="WHITE" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <StackPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="75.0" prefWidth="280.0" style="-fx-background-color: #f8eededb; -fx-background-radius: 40; -fx-border-color: black; -fx-border-width: 1px; -fx-border-radius: 40;">
                     <children>
                        <Button fx:id="logoutBtn" onAction="#onLogOut" prefHeight="44.0" prefWidth="200.0" style="-fx-background-radius: 20; -fx-background-color: ORANGE; -fx-font-family: Arial; -fx-font-size: 21px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(168, 25, 25, 0.4), 8, 0, 0, 0); -fx-border-radius: 5px;" text="LOG-OUT" textFill="WHITE" />
                     </children>
                  </StackPane>
                  
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</StackPane>